# Placeholders only. Copy to .env locally (never commit .env).

# --- Celesto (execution zone) ---
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
CELESTO_BACKEND=firecracker
CELESTO_PRICE_PER_HOUR=0.015

# --- LLM (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name
USE_LLM=0

# --- Control plane ---
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080
LEDGER_URL=http://localhost:8080
REPORTS_DIR=/app/reports
LOGS_DIR=/app/logs

# --- Agent / eval behaviour ---
AGENT_EXECUTOR=celesto
ALLOWED_HOSTS=pypi.org,files.pythonhosted.org
EVAL_RUNS=20
CONCURRENT_JOBS=5
MOCK_SEED=7
